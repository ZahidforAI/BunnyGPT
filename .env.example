# Local development only. Copy this file to .env and paste your real keys.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_SITE_URL=http://localhost:5173
YOU_API_KEY=your-you-com-key
LANGCHAIN_API_URL=http://127.0.0.1:8000

# On Vercel, LANGCHAIN_API_URL is injected automatically by the private service
# binding. Do not create it manually in the Vercel dashboard.
